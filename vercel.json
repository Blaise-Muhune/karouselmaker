{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "crons": [
    {
      "path": "/api/cron/weekly-creator-note",
      "schedule": "0 14 * * 1"
    },
    {
      "path": "/api/cron/tiktok-scheduled-posts",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/storage-cleanup",
      "schedule": "17 3 * * *"
    }
  ],
  "functions": {
    "app/(app)/p/[projectId]/new/page.tsx": {
      "maxDuration": 800
    },
    "app/api/export/[carouselId]/route.ts": {
      "maxDuration": 800
    }
  }
}
